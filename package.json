{
  "name": "prefeitura-guarara",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n WEB,API -c cyan,green \"npm run dev -w @guarara/web\" \"npm run start:dev -w @guarara/api\"",
    "build": "npm run build -w @guarara/api && npm run build -w @guarara/web",
    "db:generate": "npm run prisma:generate -w @guarara/api",
    "db:migrate": "npm run prisma:migrate -w @guarara/api",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs --update-env",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "pm2": "^6.0.0"
  }
}
