generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoDocumento {
  LEI
  DECRETO
  PORTARIA
  EDITAL
  RELATORIO
  OUTRO
}

model Comunicado {
  id          String   @id @default(cuid())
  titulo      String
  slug        String   @unique
  resumo      String?
  conteudo    String   @db.Text
  categoria   String?
  publicado   Boolean  @default(false)
  publicadoEm DateTime?
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Documento {
  id           String        @id @default(cuid())
  titulo       String
  tipo         TipoDocumento
  ano          Int
  arquivoUrl   String
  descricao    String?       @db.Text
  publicadoEm  DateTime      @default(now())
  criadoEm     DateTime      @default(now())
  @@index([tipo, ano])
}

model Secretaria {
  id          String   @id @default(cuid())
  nome        String   @unique
  descricao   String?  @db.Text
  responsavel String?
  telefone    String?
  email       String?
  criadoEm    DateTime @default(now())
}
