generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
enum PapelUsuario {
  ADMINISTRADOR
  GESTOR
  EDITOR
}
enum TipoPagina {
  GRID_LINKS
  TABELA_SIMPLES
  TABELA_ABAS
}
enum EstadoPagina {
  RASCUNHO
  PUBLICADA
  ARQUIVADA
}
enum TipoDocumento {
  LEI
  DECRETO
  PORTARIA
  EDITAL
  RELATORIO
  OUTRO
}
model Usuario {
 id String @id @default(cuid())
 nome String
 email String @unique
 senhaHash String
 papel PapelUsuario @default(EDITOR)
 ativo Boolean @default(true)
 paginas Pagina[]
 criadoEm DateTime @default(now())
 atualizadoEm DateTime @updatedAt
}
model Pagina {
 id String @id @default(cuid())
 titulo String
 slug String @unique
 subtitulo String?
 tipo TipoPagina
 estado EstadoPagina @default(RASCUNHO)
 conteudo Json
 ordem Int @default(0)
 autorId String
 autor Usuario @relation(fields:[autorId],references:[id])
 publicadoEm DateTime?
 criadoEm DateTime @default(now())
 atualizadoEm DateTime @updatedAt
 @@index([estado,ordem])
}
model Comunicado {
 id String @id @default(cuid())
 titulo String
 slug String @unique
 resumo String?
 conteudo String @db.Text
 categoria String?
 publicado Boolean @default(false)
 publicadoEm DateTime?
 criadoEm DateTime @default(now())
 atualizadoEm DateTime @updatedAt
}
model Documento {
 id String @id @default(cuid())
 titulo String
 tipo TipoDocumento
 ano Int
 arquivoUrl String
 descricao String? @db.Text
 publicadoEm DateTime @default(now())
 criadoEm DateTime @default(now())
 @@index([tipo,ano])
}
model Secretaria {
 id String @id @default(cuid())
 nome String @unique
 descricao String? @db.Text
 responsavel String?
 telefone String?
 email String?
 criadoEm DateTime @default(now())
}

enum TipoColunaTabela {
  TEXTO
  LINK
}
model Tabela {
 id String @id @default(cuid())
 nome String
 descricao String?
 colunas Json
 linhas Json
 criadoEm DateTime @default(now())
 atualizadoEm DateTime @updatedAt
}

model MenuItem {
 id String @id @default(cuid())
 nome String
 link String
 novaGuia Boolean @default(false)
 ordem Int @default(0)
 ascendenteId String?
 ascendente MenuItem? @relation("HierarquiaMenu", fields: [ascendenteId], references: [id], onDelete: Restrict)
 descendentes MenuItem[] @relation("HierarquiaMenu")
 criadoEm DateTime @default(now())
 atualizadoEm DateTime @updatedAt

 @@index([ascendenteId, ordem])
}

model CategoriaObra {
 id String @id @default(cuid())
 nome String @unique
 obras ObraPublica[]
 criadoEm DateTime @default(now())
 atualizadoEm DateTime @updatedAt
}

model RecursoObra {
 id String @id @default(cuid())
 nome String @unique
 obras ObraPublica[]
 criadoEm DateTime @default(now())
 atualizadoEm DateTime @updatedAt
}

model ObraPublica {
 id String @id @default(cuid())
 ano Int
 numero String
 objeto String @db.Text
 categoriaId String
 categoria CategoriaObra @relation(fields:[categoriaId],references:[id],onDelete:Restrict)
 recursoId String
 recurso RecursoObra @relation(fields:[recursoId],references:[id],onDelete:Restrict)
 inicio DateTime @db.Date
 comprovacaoUrl String
 criadoEm DateTime @default(now())
 atualizadoEm DateTime @updatedAt
 @@index([ano,inicio])
 @@index([categoriaId])
 @@index([recursoId])
}

enum TipoConteudoSaude {
  PAS
  CONSELHO
  PORTARIA
  ESCALA
  MEDICAMENTO
  ESTOQUE
}
model SaudeConfiguracao {
 id String @id @default("principal")
 nomeSecretario String?
 telefone String?
 endereco String?
 horario String?
 descricao String? @db.Text
 atualizadoEm DateTime @updatedAt
}
model SaudeConteudo {
 id String @id @default(cuid())
 tipo TipoConteudoSaude
 categoria String?
 titulo String
 descricao String? @db.Text
 ano Int?
 link String
 textoBotao String?
 linkSecundario String?
 textoBotaoSecundario String?
 destaque Boolean @default(false)
 ordem Int @default(0)
 criadoEm DateTime @default(now())
 atualizadoEm DateTime @updatedAt
 @@index([tipo, ordem])
 @@index([ano])
}

model ProtocoloFormulario {
 id String @id @default(cuid())
 nome String
 link String
 ordem Int @default(0)
 criadoEm DateTime @default(now())
 atualizadoEm DateTime @updatedAt
 @@index([ordem, criadoEm])
}

model GrupoEmailOficial {
 id String @id @default(cuid())
 nome String @unique
 ordem Int @default(0)
 emails EmailOficial[]
 criadoEm DateTime @default(now())
 atualizadoEm DateTime @updatedAt
 @@index([ordem, criadoEm])
}

model EmailOficial {
 id String @id @default(cuid())
 nome String
 email String
 grupoId String
 grupo GrupoEmailOficial @relation(fields:[grupoId],references:[id],onDelete:Restrict)
 ordem Int @default(0)
 criadoEm DateTime @default(now())
 atualizadoEm DateTime @updatedAt
 @@index([grupoId, ordem])
}
